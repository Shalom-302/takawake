          "format": "table",
          "group": [],
          "metricColumn": "none",
          "rawQuery": true,
          "rawSql": "SELECT \n  id,\n  created_at,\n  resource,\n  action,\n  user_id,\n  details,\n  CONCAT(TO_CHAR(created_at, 'YYYY-MM-DD HH24:MI:SS'), ' [', resource, '] ', action, ' by user ', COALESCE(CAST(user_id as TEXT), 'system')) as log_entry\nFROM kaapi_audit_logs\nORDER BY created_at DESC\nLIMIT 200",
