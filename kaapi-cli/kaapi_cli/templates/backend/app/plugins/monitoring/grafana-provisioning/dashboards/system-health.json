{
  "title": "System Health",
  "panels": [
    {
      "title": "CPU Usage",
      "type": "gauge",
      "targets": [{
        "expr": "100 - (avg by(instance)(rate(node_cpu_seconds_total{mode='idle'}[5m])) * 100)"
      }]
    },
    {
      "title": "Memory Usage",
      "type": "graph",
      "targets": [{
        "expr": "node_memory_MemTotal_bytes - node_memory_MemFree_bytes"
      }]
    }
  ]
}
