#!/bin/bash

# Script utilitaire pour faciliter l'utilisation de kaapi_cli.py
# Usage: ./kaapi <commande>

# Configuration des couleurs
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Détection du répertoire racine du projet
BASE_DIR="$(dirname "$0")"

# Fonction pour vérifier si Docker est en cours d'exécution
check_docker() {
    if ! docker ps >/dev/null 2>&1; then
        echo -e "${RED}⚠️ Docker n'est pas en cours d'exécution. Veuillez démarrer Docker et réessayer.${NC}"
        exit 1
    fi
}

# Fonction pour vérifier si le container kaapi-api est en cours d'exécution
check_kaapi_container() {
    if ! docker ps | grep kaapi-api >/dev/null 2>&1; then
        echo -e "${YELLOW}Le container kaapi-api n'est pas en cours d'exécution. Démarrage des containers...${NC}"
        cd "$BASE_DIR/backend" && docker-compose up -d
        echo -e "${GREEN}Containers démarrés avec succès.${NC}"
    fi
}

# Fonction pour exécuter une commande dans un container Docker
run_in_container() {
    local container="$1"
    shift
    local cmd="$@"
    
    echo -e "${BLUE}Exécution de la commande dans $container: $cmd${NC}"
    docker exec "$container" bash -c "$cmd"
    local exit_code=$?
    
    if [ $exit_code -ne 0 ]; then
        echo -e "${RED}⚠️ La commande a échoué avec le code de sortie $exit_code${NC}"
        return $exit_code
    fi
    
    return 0
}


# Afficher l'usage si aucun argument n'est fourni
if [ $# -eq 0 ]; then
    echo -e "${YELLOW}Usage: ./kaapi <commande>${NC}"
    echo -e "${BLUE}Commandes disponibles:${NC}"
    echo -e "  db generate ${GREEN}# Générer une nouvelle migration (optionnel: message)${NC}"
    echo -e "  db apply    ${GREEN}# Appliquer les migrations${NC}"
    echo -e "  db preview  ${GREEN}# Prévisualiser les changements de migration${NC}"
    echo -e "  auth init   ${GREEN}# Initialiser l'authentification (créer un user test, configurer les providers)${NC}"
    echo -e "  auth init-simple ${GREEN}# Version simplifiée de l'initialisation d'authentification${NC}"
    echo -e "  storage init ${GREEN}# Initialize the MinIO storage provider and set it as default${NC}"
    echo -e "  [...]      ${GREEN}# Autres commandes de kaapi_cli.py${NC}"
    exit 0
fi

# Vérifier si Docker est en cours d'exécution
check_docker

if [[ "$1" == "db" ]]; then
    # Commandes de gestion de base de données
    shift  # Supprime 'db' des arguments
    CMD="$1"
    shift  # Supprime la commande spécifique
    
    # S'assurer que le container api est en cours d'exécution
    check_kaapi_container

    case "$CMD" in
        "generate")
            # Joindre tous les arguments restants comme un seul message
            MESSAGE="$*"
            if [ -z "$MESSAGE" ]; then
                MESSAGE="Kaapi changes"
            fi
            echo -e "${BLUE}Génération d'une migration avec le message: $MESSAGE${NC}"
            # Utiliser des guillemets simples pour éviter les problèmes d'échappement
            run_in_container kaapi-api "cd /app && alembic revision --autogenerate -m \"$MESSAGE\""
            ;;
        "apply")
            echo -e "${BLUE}Application des migrations...${NC}"
            run_in_container kaapi-api alembic upgrade head
            
            # La génération des schémas est maintenant intégrée au processus de migration
            echo -e "${GREEN}Migrations appliquées et schémas générés avec succès dans le répertoire docs/${NC}"
            ;;
        "preview")
            echo -e "${BLUE}Prévisualisation des changements...${NC}"
            run_in_container kaapi-api python -m app.commands.preview_migration
            ;;
        *)
            echo -e "${RED}Commande db inconnue: $CMD${NC}"
            echo -e "${YELLOW}Commandes disponibles: generate, apply, preview${NC}"
            exit 1
            ;;
    esac
elif [[ "$1" == "auth" ]]; then
    # Commandes de gestion de l'authentification
    shift  # Supprime 'auth' des arguments
    CMD="$1"
    shift  # Supprime la commande spécifique
    
    # S'assurer que le container api est en cours d'exécution
    check_kaapi_container

    case "$CMD" in
        "init")
            echo -e "${BLUE}Initialisation de l'authentification...${NC}"
            if [[ "$1" == "--force" ]]; then
                run_in_container kaapi-api python -m app.commands.init_auth --force
            else
                run_in_container kaapi-api python -m app.commands.init_auth
            fi
            ;;
        "init-simple")
            echo -e "${BLUE}Initialisation simplifiée de l'authentification...${NC}"
            if [[ "$1" == "--force" ]]; then
                run_in_container kaapi-api python -m app.commands.init_auth_simple --force
            else
                run_in_container kaapi-api python -m app.commands.init_auth_simple
            fi
            ;;
        *)
            echo -e "${RED}Commande auth inconnue: $CMD${NC}"
            echo -e "${YELLOW}Commandes disponibles: init, init-simple${NC}"
            exit 1
            ;;
    esac
elif [[ "$1" == "storage" ]]; then
    # Storage management commands
    shift  # Remove 'storage' from arguments
    CMD="$1"
    shift  # Remove the specific command
    
    # Ensure api container is running
    check_kaapi_container

    case "$CMD" in
        "init")
            echo -e "${BLUE}Initializing MinIO storage provider...${NC}"
            # Parse additional options
            EXTRA_ARGS=""
            
            while [[ "$#" -gt 0 ]]; do
                case "$1" in
                    --endpoint=*)
                        EXTRA_ARGS="$EXTRA_ARGS --endpoint=${1#*=}"
                        ;;
                    --bucket=*)
                        EXTRA_ARGS="$EXTRA_ARGS --bucket=${1#*=}"
                        ;;
                    --access-key=*)
                        EXTRA_ARGS="$EXTRA_ARGS --access-key=${1#*=}"
                        ;;
                    --secret-key=*)
                        EXTRA_ARGS="$EXTRA_ARGS --secret-key=${1#*=}"
                        ;;
                    --region=*)
                        EXTRA_ARGS="$EXTRA_ARGS --region=${1#*=}"
                        ;;
                    --secure)
                        EXTRA_ARGS="$EXTRA_ARGS --secure"
                        ;;
                    --force)
                        EXTRA_ARGS="$EXTRA_ARGS --force"
                        ;;
                    *)
                        echo -e "${RED}Unknown option: $1${NC}"
                        exit 1
                        ;;
                esac
                shift
            done
            
            # First, generate the SQL script
            if run_in_container kaapi-api python -m app.commands.init_storage $EXTRA_ARGS; then
                # Copier le fichier SQL du conteneur API vers l'hôte
                echo -e "${BLUE}Copying SQL script from API container...${NC}"
                docker cp kaapi-api:/tmp/init_minio.sql ./init_minio.sql
                
                # Exécuter le script SQL directement dans le conteneur de base de données
                echo -e "${BLUE}Running SQL commands to set up MinIO provider...${NC}"
                
                # Exécuter des commandes simples pour voir les variables d'environnement disponibles
                echo -e "${BLUE}Checking database environment variables...${NC}"
                run_in_container kaapi-db env | grep POSTGRES
                
                # Exécuter le script SQL avec une commande plus robuste
                docker cp ./init_minio.sql kaapi-db:/tmp/init_minio.sql
                docker exec kaapi-db sh -c 'psql -U postgres -d kaapi -f /tmp/init_minio.sql'
                
                # Nettoyage du fichier temporaire sur l'hôte
                rm ./init_minio.sql
                
                echo -e "${GREEN}MinIO storage provider initialized successfully.${NC}"
                
                # Vérifier que le fournisseur a bien été créé
                echo -e "${BLUE}Verifying provider creation...${NC}"
                docker exec kaapi-db sh -c 'psql -U postgres -d kaapi -c "SELECT * FROM file_storage_providers;"'
            else
                echo -e "${RED}Failed to generate SQL script for MinIO initialization.${NC}"
                exit 1
            fi
            ;;
        *)
            echo -e "${RED}Unknown storage command: $CMD${NC}"
            echo -e "${YELLOW}Available commands: init${NC}"
            exit 1
            ;;
    esac
else
    # Autres commandes, exécution dans le container
    check_kaapi_container
    run_in_container kaapi-api python kaapi_cli.py "$@"
fi
