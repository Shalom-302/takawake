#!/bin/bash

# Script utility to facilitate the use of kaapi_cli.py
# Usage: ./kaapi <command>

# Color configuration
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Detect root directory of the project
BASE_DIR="$(dirname "$0")"

# Function to check if Docker is running
check_docker() {
    if ! docker ps >/dev/null 2>&1; then
        echo -e "${RED}⚠️ Docker is not running. Please start Docker and try again.${NC}"
        exit 1
    fi
}

# Function to check if the kaapi-api container is running
check_kaapi_container() {
    if ! docker ps | grep kaapi-api >/dev/null 2>&1; then
        echo -e "${YELLOW}The kaapi-api container is not running. Starting containers...${NC}"
        cd "$BASE_DIR/backend" && docker-compose up -d
        echo -e "${GREEN}Containers started successfully.${NC}"
    fi
}

# Function to run a command in a Docker container
run_in_container() {
    local container="$1"
    shift
    local cmd="$@"
    
    echo -e "${BLUE}Executing command in $container: $cmd${NC}"
    docker exec "$container" bash -c "$cmd"
    local exit_code=$?
    
    if [ $exit_code -ne 0 ]; then
        echo -e "${RED}⚠️ Command failed with exit code $exit_code${NC}"
        return $exit_code
    fi
    
    return 0
}


# Display usage if no arguments are provided
if [ $# -eq 0 ]; then
    echo -e "${YELLOW}Usage: ./kaapi <command>${NC}"
    echo -e "${BLUE}Available commands:${NC}"
    echo -e "  db generate ${GREEN}# Generate a new migration (optional: message)${NC}"
    echo -e "  db apply    ${GREEN}# Apply migrations${NC}"
    echo -e "  db preview  ${GREEN}# Preview migration changes${NC}"
    echo -e "  auth init   ${GREEN}# Initialize authentication (create a test user, configure providers)${NC}"
    echo -e "  auth init-simple ${GREEN}# Simple version of authentication initialization${NC}"
    echo -e "  storage init ${GREEN}# Initialize the MinIO storage provider and set it as default${NC}"
    echo -e "  [...]      ${GREEN}# Other kaapi_cli.py commands${NC}"
    exit 0
fi

# Check if Docker is running
check_docker

if [[ "$1" == "db" ]]; then
    # Database management commands
    shift  # Remove 'db' from arguments
    CMD="$1"
    shift  # Remove the specific command
    
    # Ensure the container api is running
    check_kaapi_container

    case "$CMD" in
        "generate")
            # Attach all remaining arguments as a single message
            MESSAGE="$*"
            if [ -z "$MESSAGE" ]; then
                MESSAGE="Kaapi changes"
            fi
            echo -e "${BLUE}Generating a migration with message: $MESSAGE${NC}"
            # Use single quotes to avoid escape issues
            run_in_container kaapi-api "cd /app && alembic revision --autogenerate -m \"$MESSAGE\""
            ;;
        "apply")
            echo -e "${BLUE}Applying migrations...${NC}"
            run_in_container kaapi-api alembic upgrade head
            
            # Schema generation is now integrated into the migration process
            echo -e "${GREEN}Migrations applied and schemas generated successfully in the docs directory/${NC}"
            ;;
        "preview")
            echo -e "${BLUE}Previewing changes...${NC}"
            run_in_container kaapi-api python -m app.commands.preview_migration
            ;;
        *)
            echo -e "${RED}Unknown db command: $CMD${NC}"
            echo -e "${YELLOW}Available commands: generate, apply, preview${NC}"
            exit 1
            ;;
    esac
elif [[ "$1" == "auth" ]]; then
    # Authentication management commands
    shift  # Remove 'auth' from arguments
    CMD="$1"
    shift  # Remove the specific command
    
    # Ensure the container api is running
    check_kaapi_container

    case "$CMD" in
        "init")
            echo -e "${BLUE}Initializing authentication...${NC}"
            if [[ "$1" == "--force" ]]; then
                run_in_container kaapi-api python -m app.commands.init_auth --force
            else
                run_in_container kaapi-api python -m app.commands.init_auth
            fi
            ;;
        "init-simple")
            echo -e "${BLUE}Initializing authentication simplifiée...${NC}"
            if [[ "$1" == "--force" ]]; then
                run_in_container kaapi-api python -m app.commands.init_auth_simple --force
            else
                run_in_container kaapi-api python -m app.commands.init_auth_simple
            fi
            ;;
        *)
            echo -e "${RED}Unknown auth command: $CMD${NC}"
            echo -e "${YELLOW}Available commands: init, init-simple${NC}"
            exit 1
            ;;
    esac
elif [[ "$1" == "storage" ]]; then
    # Storage management commands
    shift  # Remove 'storage' from arguments
    CMD="$1"
    shift  # Remove the specific command
    
    # Ensure api container is running
    check_kaapi_container

    case "$CMD" in
        "init")
            echo -e "${BLUE}Initializing MinIO storage provider...${NC}"
            # Parse additional options
            EXTRA_ARGS=""
            
            while [[ "$#" -gt 0 ]]; do
                case "$1" in
                    --endpoint=*)
                        EXTRA_ARGS="$EXTRA_ARGS --endpoint=${1#*=}"
                        ;;
                    --bucket=*)
                        EXTRA_ARGS="$EXTRA_ARGS --bucket=${1#*=}"
                        ;;
                    --access-key=*)
                        EXTRA_ARGS="$EXTRA_ARGS --access-key=${1#*=}"
                        ;;
                    --secret-key=*)
                        EXTRA_ARGS="$EXTRA_ARGS --secret-key=${1#*=}"
                        ;;
                    --region=*)
                        EXTRA_ARGS="$EXTRA_ARGS --region=${1#*=}"
                        ;;
                    --secure)
                        EXTRA_ARGS="$EXTRA_ARGS --secure"
                        ;;
                    --force)
                        EXTRA_ARGS="$EXTRA_ARGS --force"
                        ;;
                    *)
                        echo -e "${RED}Unknown option: $1${NC}"
                        exit 1
                        ;;
                esac
                shift
            done
            
            # First, generate the SQL script
            if run_in_container kaapi-api python -m app.commands.init_storage $EXTRA_ARGS; then
                # Copy the SQL script from the API container to the host
                echo -e "${BLUE}Copying SQL script from API container...${NC}"
                docker cp kaapi-api:/tmp/init_minio.sql ./init_minio.sql
                
                # Run SQL commands to set up MinIO provider
                echo -e "${BLUE}Running SQL commands to set up MinIO provider...${NC}"
                
                # Check database environment variables
                echo -e "${BLUE}Checking database environment variables...${NC}"
                run_in_container kaapi-db env | grep POSTGRES
                
                # Run SQL commands to set up MinIO provider
                docker cp ./init_minio.sql kaapi-db:/tmp/init_minio.sql
                docker exec kaapi-db sh -c 'psql -U postgres -d kaapi -f /tmp/init_minio.sql'
                
                # Clean up temporary file on host
                rm ./init_minio.sql
                
                echo -e "${GREEN}MinIO storage provider initialized successfully.${NC}"
                
                # Verify that the provider has been created
                echo -e "${BLUE}Verifying provider creation...${NC}"
                docker exec kaapi-db sh -c 'psql -U postgres -d kaapi -c "SELECT * FROM file_storage_providers;"'
            else
                echo -e "${RED}Failed to generate SQL script for MinIO initialization.${NC}"
                exit 1
            fi
            ;;
        *)
            echo -e "${RED}Unknown storage command: $CMD${NC}"
            echo -e "${YELLOW}Available commands: init${NC}"
            exit 1
            ;;
    esac
else
    # Other commands, execution in container
    check_kaapi_container
    run_in_container kaapi-api python kaapi_cli.py "$@"
fi
