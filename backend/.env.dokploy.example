# Variables à renseigner dans l'onglet "Environment" de Dokploy pour le backend.
# Ne PAS committer le .env réel.

# --- Secrets data layer (génère des valeurs fortes en prod) ---
POSTGRES_PASSWORD=change-moi
VAULT_TOKEN=change-moi
MINIO_ACCESS_KEY=change-moi
MINIO_SECRET_KEY=change-moi

# --- Environnement applicatif ---
ENVIRONMENT=production

# --- Qdrant (mémoire vectorielle, partagée avec le MCP) ---
QDRANT_URL=https://qdrant-client.kortexai.dev
QDRANT_API_KEY=

# --- Clés LLM (optionnelles selon les plugins utilisés) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
