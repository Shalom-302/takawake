# Variables à renseigner dans l'onglet "Environment" de Dokploy pour le backend.
# Ne PAS committer le .env réel.

# --- Secrets data layer (génère des valeurs fortes en prod) ---
POSTGRES_PASSWORD=change-moi
VAULT_TOKEN=change-moi
MINIO_ACCESS_KEY=change-moi
MINIO_SECRET_KEY=change-moi

# --- Clés de chiffrement seedées dans Vault au démarrage (service vault-seed) ---
# OBLIGATOIRE : l'API crashe au boot sans une clé AES valide dans Vault.
# Génère-les UNE fois et garde-les stables (sinon données chiffrées illisibles) :
#   AES    : python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
#   Fernet : python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
KAAPI_AES_KEY=
KAAPI_FERNET_KEY=

# --- Environnement applicatif ---
ENVIRONMENT=production

# --- Domaine public (front + API sur le même host, cf. CORS_ORIGINS) ---
CORS_ORIGINS=["https://tekawake.com","https://www.tekawake.com"]

# --- Qdrant (mémoire vectorielle, partagée avec le MCP) ---
# Conteneur `qdrant` du VPS : joignable en interne uniquement (aucun port publié).
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# --- Clés LLM (optionnelles selon les plugins utilisés) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
