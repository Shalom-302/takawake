# Copier en .env et remplir. NE PAS committer le .env réel.

# Token Bearer que les clients devront fournir (génère-en un long et aléatoire).
MCP_API_TOKEN=remplace-par-un-token-long-et-aleatoire

# Accès Qdrant (même instance que le backend).
QDRANT_URL=https://qdrant-client.kortexai.dev
QDRANT_API_KEY=

# Collection mémoire-code (ne pas confondre avec tekawake_articles).
CODEMAP_COLLECTION=kaapi_backend_memory

# Modèle d'embedding (doit être celui qui a produit l'index).
EMBED_MODEL=intfloat/multilingual-e5-base

# Réseau interne au container.
HOST=0.0.0.0
PORT=8000
